# Leave ANTHROPIC_API_KEY unset to run the deterministic fake LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# LLM_PROVIDER=fake|anthropic (defaults from ANTHROPIC_API_KEY presence)
LLM_PROVIDER=

# Optional Langfuse tracing; no-op when unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Run history in MongoDB; unset means SQLite (keyless default).
# MONGO_URL=mongodb://localhost:27017
MONGO_DB=agent_console

# Shared secret the Express gateway sends to FastAPI as X-Internal-Token.
INTERNAL_TOKEN=dev-token
AGENT_URL=http://localhost:8000
